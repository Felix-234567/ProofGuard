{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=proveguard.db"
  },
  "App": {
    "BaseUrl": "http://localhost:5000"
  },
  "Firebase": {
    "ProjectId": "YOUR_FIREBASE_PROJECT_ID"
  },
  "Paystack": {
    "SecretKey": "sk_test_placeholder",
    "CallbackUrl": "http://localhost:3000/callback"
  },
  "Storage": {
    "LocalFolder": "uploads"
  },
  "Cloudflare": {
    "D1": {
      "AccountId": "YOUR_CLOUDFLARE_ACCOUNT_ID",
      "DatabaseId": "YOUR_CLOUDFLARE_DATABASE_ID",
      "ApiToken": "YOUR_CLOUDFLARE_D1_API_TOKEN"
    },
    "R2": {
      "AccountId": "YOUR_CLOUDFLARE_ACCOUNT_ID",
      "AccessKeyId": "YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID",
      "SecretAccessKey": "YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY",
      "BucketName": "YOUR_CLOUDFLARE_R2_BUCKET_NAME"
    }
  }
}
